# Track the active application, its runtime configuration, and requirements only.
/*
!/.gitignore
!/README.md
!/Laravel-Tutorial-PJ/
!/docs/

/Laravel-Tutorial-PJ/*
!/Laravel-Tutorial-PJ/compose.yaml
!/Laravel-Tutorial-PJ/.env.example
!/Laravel-Tutorial-PJ/docker/
!/Laravel-Tutorial-PJ/src/
/Laravel-Tutorial-PJ/src/*
!/Laravel-Tutorial-PJ/src/TaskList/

/docs/*
!/docs/todo-app-requirements.md

# Credentials, databases, dependencies, and generated local files.
**/.env
**/.env.*
!**/.env.example
**/auth.json
**/credentials*.json
**/*.pem
**/*.key
**/*.sqlite*
**/*.sql
**/*.sql.gz
**/*.log
**/vendor/
**/node_modules/
**/.DS_Store
